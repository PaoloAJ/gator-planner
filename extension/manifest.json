{
  "manifest_version": 3,
  "name": "GatorPlan Degree Audit Import",
  "short_name": "GatorPlan",
  "version": "1.0.0",
  "description": "Sends your UF degree audit from ONE.UF to GatorPlan, with your name, UFID, grades, and GPA removed, so you can plan your degree.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Send my degree audit to GatorPlan",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://one.uf.edu/*"],
      "js": ["src/capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://one.uf.edu/*"],
      "js": ["src/config.js", "src/redact.js", "src/oneuf.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["src/gatorplan.js"],
      "run_at": "document_start"
    }
  ]
}
